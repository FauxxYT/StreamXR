        "src/streamxr/shared/strings-es.js",
        "src/streamxr/shared/formats.js",
        "src/core/page/math3d.js",
        "src/core/page/pose-smoother.js",
        "src/core/page/gl-utils.js",
        "src/core/page/storage.js",
        "src/core/page/sites.js",
        "src/core/page/frame-clock.js",
        "src/core/page/diagnostics.js",
        "src/core/page/input.js",
