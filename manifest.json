        "src/core/page/vr-panel/styles/queue.js",
        "src/core/page/vr-panel/styles/catalog.js",
        "src/core/page/vr-panel/styles/profile.js",
        "src/core/page/vr-panel/styles/info.js",
        "src/core/page/vr-panel/styles/options.js",
        "src/core/page/vr-panel/orbiters-ui.js",
