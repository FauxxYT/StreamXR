{
  "manifest_version": 3,
  "name": "StreamXR Skip Helper for YouTube",
  "version": "1.3.1",
  "description": "Optional companion to StreamXR: presses YouTube's Skip ad button when you press Skip ad in VR.",
  "key": "",
  "action": {
    "default_title": "StreamXR Skip Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger"
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
